# Environment Variables Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to git!

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# Node Environment (development, production, test)
NODE_ENV=production

# Application Port (default: 3000)
PORT=3000

# Site URL (your domain or IP)
SITE_URL=https://tejasm.dev

# ============================================================================
# DATABASE (if you add one later)
# ============================================================================

# DATABASE_URL=postgresql://user:password@localhost:5432/tejasm_dev
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10

# ============================================================================
# API KEYS & EXTERNAL SERVICES
# ============================================================================

# GitHub API (for fetching repos, if needed)
# GITHUB_TOKEN=your_github_personal_access_token

# Google Analytics (if you want analytics)
# GA_TRACKING_ID=G-XXXXXXXXXX

# Email Service (if you add contact form)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# CONTACT_EMAIL=contact@tejasm.dev

# ============================================================================
# SECURITY
# ============================================================================

# Session Secret (generate with: openssl rand -base64 32)
# SESSION_SECRET=your-random-secret-key-here

# JWT Secret (if you add authentication)
# JWT_SECRET=your-jwt-secret-key-here
# JWT_EXPIRES_IN=7d

# CORS Origins (comma-separated)
# CORS_ORIGINS=https://tejasm.dev,https://www.tejasm.dev

# ============================================================================
# CACHE & REDIS (if you add caching)
# ============================================================================

# REDIS_URL=redis://localhost:6379
# REDIS_TTL=3600

# ============================================================================
# MONITORING & LOGGING
# ============================================================================

# Sentry DSN (for error tracking)
# SENTRY_DSN=https://your-sentry-dsn

# Log Level (error, warn, info, debug)
LOG_LEVEL=info

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable/disable features
# ENABLE_BLOG=true
# ENABLE_COMMENTS=false
# ENABLE_ANALYTICS=true

# ============================================================================
# THIRD-PARTY INTEGRATIONS
# ============================================================================

# Cloudinary (for image hosting)
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# Stripe (for payments, if needed)
# STRIPE_PUBLIC_KEY=pk_test_xxx
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# ============================================================================
# DEPLOYMENT SETTINGS
# ============================================================================

# PM2 Instance Name
APP_NAME=tejasm-dev

# Maximum memory before restart (MB)
MAX_MEMORY_RESTART=1000

# Number of PM2 instances (for cluster mode)
PM2_INSTANCES=1

# ============================================================================
# DEVELOPMENT ONLY
# ============================================================================

# Enable debug mode
# DEBUG=true

# Mock external APIs
# MOCK_APIS=false

# ============================================================================
# NOTES
# ============================================================================
# 
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual values in .env
# 3. Never commit .env to git
# 4. Keep this .env.example updated with new variables
# 5. Document each variable clearly
# 
# For production on DigitalOcean:
# - Use PM2 ecosystem.config.js for environment variables
# - Or create .env on server: nano /var/www/tejasm-dev/current/.env
# 
